# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...tapi .env.example WAJIB ikut ter-commit: isinya cuma nama variabel tanpa
# nilai rahasia, dan itu kontrak env buat seluruh tim.
!.env.example

# prisma client hasil generate - jangan di-commit, tiap orang generate sendiri
# lewat `npm install` (otomatis via script postinstall)
/src/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon
