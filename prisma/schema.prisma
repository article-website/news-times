// Schema database NewsTimes
// Pemilik: Orang 1 (Database)
//
// Perubahan schema WAJIB dibahas bareng tim dulu (lihat docs/RENCANA-KERJA.md aturan no.3),
// karena kode Orang 2/3/4 dibangun di atas bentuk data ini.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Catatan Prisma 7: `url` sudah tidak boleh ditulis di sini lagi.
// Connection string untuk migrate ada di prisma.config.ts,
// dan untuk aplikasi ada di src/server/db/client.ts lewat driver adapter.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Artikel
// ---------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String @db.VarChar(500)
  content String

  // Boleh kosong: artikel tanpa gambar termasuk kasus yang harus tetap tampil rapi.
  // Isinya URL ke Vercel Blob, bukan path ke folder public/.
  imageUrl String?

  status ArticleStatus @default(DRAFT)

  // Sengaja nullable: draft belum punya tanggal terbit.
  // Kalau diisi tanggal masa depan, artinya artikel dijadwalkan tayang.
  publishedAt DateTime?

  // Dipakai PopularArticles di sidebar. Tanpa kolom ini, "populer" cuma tebak-tebakan.
  viewCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // Index gabungan, urutannya mengikuti query yang paling sering dipakai.
  // Halaman depan: ambil yang PUBLISHED, urut dari terbaru.
  @@index([status, publishedAt(sort: Desc)])
  // Halaman kategori: filter kategori dulu, baru status, baru urut terbaru.
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([status, viewCount(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Kategori & penulis
// ---------------------------------------------------------------------------

model Category {
  id   String @id @default(cuid())
  slug String @unique
  name String @unique

  // Buat ngatur urutan tampil di navbar tanpa hardcode di komponen.
  order Int @default(0)

  articles Article[]

  @@index([order])
}

model Author {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  bio       String?
  avatarUrl String?

  articles Article[]
}

// ---------------------------------------------------------------------------
// Akun admin (dipakai Orang 3)
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  // HANYA hash, jangan pernah simpan password asli.
  passwordHash String

  role UserRole @default(EDITOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Newsletter (dipakai Orang 4)
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id    String @id @default(cuid())
  email String @unique

  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([unsubscribedAt])
}
