# =============================================================================
# CONTOH VARIABEL LINGKUNGAN - NewsTimes
# =============================================================================
#
# Cara pakai:
#   1. Salin file ini jadi `.env.local`  ->  cp .env.example .env.local
#   2. Isi nilainya sesuai punyamu
#
# Kenapa `.env.local`, bukan `.env`?
# Karena itu konvensi Next.js untuk rahasia di komputer masing-masing, dan
# Neon init juga menaruh connection string di situ. Dipakai satu file saja
# supaya tidak ada dua tempat yang harus disamakan.
#
# `.env.local` TIDAK BOLEH di-commit (sudah diblokir .gitignore).
# `.env.example` ini WAJIB di-commit: isinya cuma nama variabel, tanpa nilai
# rahasia. Ini kontrak env buat seluruh tim.
#
# Nambah variabel baru? Tambahkan juga di sini, di PR yang sama.
#
# CATATAN: perintah di luar Next.js (`prisma migrate`, `npm run db:seed`)
# tidak otomatis membaca file .env. Itu diurus prisma/load-env.ts.
# =============================================================================


# -----------------------------------------------------------------------------
# Sumber data                                          (pemilik: Orang 1)
# -----------------------------------------------------------------------------
# memory = pakai data palsu dari src/data/articles.ts (tidak butuh database)
# prisma = pakai database PostgreSQL beneran
#
# Selama Sprint 1 biarkan "memory" - kamu tidak butuh database sama sekali.
# Ganti ke "prisma" hanya kalau kamu sudah punya Neon sendiri dan sudah
# menjalankan npm run db:migrate + npm run db:seed.
DATA_SOURCE=memory


# -----------------------------------------------------------------------------
# Database                                             (pemilik: Orang 1)
# -----------------------------------------------------------------------------
# Connection string PostgreSQL dari Neon (https://neon.tech).
# Ambil yang versi "Pooled connection".
#
# Wajib pakai ?sslmode=require - Neon menolak koneksi tanpa SSL.
#
# Boleh dikosongkan selama DATA_SOURCE masih "memory".
#
# JANGAN pakai punya orang lain. Tiap orang bikin Neon sendiri (gratis 100
# project per akun). Kalau satu database dipakai berlima, orang yang lagi
# menguji fitur hapus artikel akan menghapus data semua orang.
DATABASE_URL="postgresql://user:password@host.neon.tech/newstimes?sslmode=require"


# -----------------------------------------------------------------------------
# Login admin                                          (pemilik: Orang 3)
# -----------------------------------------------------------------------------
# Kunci acak buat menandatangani sesi login.
# Bikin yang baru dengan:  npx auth secret
# JANGAN pakai nilai contoh ini di produksi.
# AUTH_SECRET=""

# URL dasar aplikasi. Di lokal biarkan seperti ini.
# AUTH_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# Upload gambar                                        (pemilik: Orang 3)
# -----------------------------------------------------------------------------
# Token Vercel Blob. Ambil dari dashboard Vercel > Storage > Blob.
# BLOB_READ_WRITE_TOKEN=""


# -----------------------------------------------------------------------------
# Situs                                                (pemilik: Orang 4)
# -----------------------------------------------------------------------------
# Dipakai buat bikin URL lengkap di sitemap.xml, rss.xml, dan preview share.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
